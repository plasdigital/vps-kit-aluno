# Modelo do arquivo de segredos do n8n.
#
# O arquivo de verdade vive SÓ na VPS, em /opt/infra/n8n/n8n.env, com
# chmod 600 e dono root — nunca aqui, nunca no git. Este exemplo existe
# para lembrar o formato e o que cada valor é.
#
# Guarde uma cópia destes valores no seu gerenciador de senhas.
#
# Mesmo raciocínio do chatwoot.env.exemplo: arquivo de ambiente, não Docker
# secret — o n8n lê estas variáveis direto e não aceita a variante _FILE.
# Consequência assumida: as senhas aparecem em `docker service inspect`.
# Quem roda esse comando já é root e teria o banco inteiro de qualquer jeito.
#
# Gerar valores novos (na VPS):
#   openssl rand -hex 32          # senhas
#   openssl rand -hex 16          # encryption key

# senha do Postgres da stack (usada pelo banco, pelo n8n e pelo backup)
POSTGRES_PASSWORD=troque-me

# senha do Redis (fila do modo queue)
REDIS_PASSWORD=troque-me

# chave que cifra as credenciais salvas no banco (tokens, senhas de outras
# integrações que os workflows guardarem).
# ⚠️ NUNCA reaproveitar a chave de outra instalação sua. Trocar
# depois de instalado torna todas as credenciais salvas ilegíveis — não tem
# como recuperar, só recriar cada credencial na mão.
N8N_ENCRYPTION_KEY=troque-me
