# Modelo do arquivo de segredos do NocoDB.
#
# O arquivo de verdade vive SÓ na VPS, em /opt/infra/nocodb/nocodb.env, com
# chmod 600 e dono root — nunca aqui, nunca no git. Este exemplo existe
# para lembrar o formato e o que cada valor é.
#
# Guarde uma cópia destes valores no seu gerenciador de senhas.
#
# Mesmo raciocínio do n8n.env.exemplo: arquivo de ambiente, não Docker
# secret — o NocoDB lê estas variáveis direto. Consequência assumida: as
# senhas aparecem em `docker service inspect`. Quem roda esse comando já é
# root e teria o banco inteiro de qualquer jeito.
#
# Gerar valores novos (na VPS):
#   openssl rand -hex 32          # senha do Postgres
#   openssl rand -hex 16          # JWT secret

# senha do Postgres da stack (usada pelo banco, pelo NocoDB e pelo backup)
POSTGRES_PASSWORD=troque-me

# chave que assina o token de sessão dos usuários do NocoDB.
# ⚠️ Trocar depois de instalado derruba a sessão de todo mundo logado (não
# corrompe dado — só força login de novo). Nunca reaproveitar a chave de
# outra instalação sua.
NC_AUTH_JWT_SECRET=troque-me
