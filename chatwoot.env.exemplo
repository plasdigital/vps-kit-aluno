# Modelo do arquivo de segredos do Chatwoot.
#
# O arquivo de verdade vive SÓ na VPS, em /opt/infra/chatwoot/chatwoot.env,
# com chmod 600 e dono root — nunca aqui, nunca no git. Este exemplo existe
# para lembrar o formato e o que cada valor é.
#
# Guarde uma cópia dos valores no seu gerenciador de senhas — nunca no git.
#
# Por que arquivo de ambiente e não Docker secret, como no Portainer: o
# Chatwoot lê estas três como variável de ambiente e não aceita a variante
# _FILE. Secret exigiria um wrapper de entrypoint só para reexportar arquivo
# em variável — complexidade que o princípio 3 do padrão manda evitar.
# Consequência assumida: as senhas aparecem em `docker service inspect`.
# Quem roda esse comando já é root e teria o banco inteiro de qualquer jeito.
#
# Gerar valores novos (na VPS):
#   openssl rand -hex 32

# senha do Postgres da stack (usada pelo banco, pelo Chatwoot e pelo backup)
POSTGRES_PASSWORD=troque-me

# senha do Redis
REDIS_PASSWORD=troque-me

# chave que assina os cookies de sessão do Rails.
# ⚠️ Trocar depois de instalado desloga todo mundo e invalida sessão salva.
SECRET_KEY_BASE=troque-me
