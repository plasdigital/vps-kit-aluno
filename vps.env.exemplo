# Os parâmetros da SUA instalação. Não tem segredo aqui — senha fica no
# chatwoot.env, dentro da VPS, e nunca neste arquivo.
#
# Copie para vps.env e preencha os dois hosts. O resto pode ficar como está.

# Rede que liga o Traefik às aplicações.
REDE_INTERNA=<TROQUE_PELO_SEU_REDE_INTERNA>

# Quem recebe aviso de expiração de certificado. Use um e-mail que você lê.
ACME_EMAIL=voce@seudominio.com

# ── os dois endereços que VOCÊ preenche ──────────────────────────────────
# Cada um precisa de um registro A apontando para o IP da sua VPS, criado
# ANTES de subir a stack — o certificado é emitido conferindo o nome.
PORTAINER_HOST=portainer.seudominio.com.br
CHATWOOT_HOST=chat.seudominio.com.br

# ── versões fixadas ──────────────────────────────────────────────────────
# Nunca use `latest`: o container troca de versão sozinho no primeiro restart
# e você descobre pelo cliente reclamando. Estas são as que estão rodando na
# instalação de referência — subir de versão é decisão, não higiene.
TRAEFIK_VERSAO=v3.7.10
PORTAINER_VERSAO=2.44.0

CHATWOOT_VERSAO=v4.16.2
# pgvector, e não Postgres puro: é o que o compose oficial do Chatwoot usa —
# as funções de IA da v4 dependem da extensão. Trocar depois dá trabalho.
CHATWOOT_PG_IMAGEM=<TROQUE_PELO_SEU_CHATWOOT_PG_IMAGEM>
CHATWOOT_REDIS_IMAGEM=<TROQUE_PELO_SEU_CHATWOOT_REDIS_IMAGEM>
