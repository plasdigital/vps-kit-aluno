# Os parâmetros da SUA instalação. Não tem segredo aqui — senha fica no
# arquivo de segredos de cada aplicacao, dentro da VPS, e nunca neste.
#
# Copie para vps.env e preencha os hosts das aplicacoes que voce vai instalar.
# O resto pode ficar como esta.

# Rede que liga o Traefik às aplicações.
REDE_INTERNA=network_public

# Quem recebe aviso de expiração de certificado. Use um e-mail que você lê.
ACME_EMAIL=voce@seudominio.com

# ── os endereços que VOCÊ preenche ───────────────────────────────────────
# Cada um precisa de um registro A apontando para o IP da sua VPS, criado
# ANTES de subir a stack — o certificado é emitido conferindo o nome.
# Só preencha o de quem você vai instalar de fato. Instalar as quatro coisas
# de uma vez é o erro mais comum: suba uma, confirme que abre com cadeado, e
# só então a próxima.
PORTAINER_HOST=portainer.seudominio.com.br
CHATWOOT_HOST=chat.seudominio.com.br
N8N_HOST=n8n.seudominio.com.br
# O n8n usa DOIS endereços: um para a tela do editor e outro para receber os
# webhooks. É assim de propósito — o processo que atende webhook é separado
# do que desenha o fluxo, e quem chama seu webhook não passa pelo editor.
N8N_WEBHOOK_HOST=webhook.seudominio.com.br
NOCO_HOST=noco.seudominio.com.br

# ── versões fixadas ──────────────────────────────────────────────────────
# Nunca use `latest`: o container troca de versão sozinho no primeiro restart
# e você descobre pelo cliente reclamando. Estas são as que estão rodando na
# instalação de referência — subir de versão é decisão, não higiene.
TRAEFIK_VERSAO=v3.7.10
PORTAINER_VERSAO=2.44.0

CHATWOOT_VERSAO=v4.16.2
# pgvector, e não Postgres puro: é o que o compose oficial do Chatwoot usa —
# as funções de IA da v4 dependem da extensão. Trocar depois dá trabalho.
CHATWOOT_PG_IMAGEM=pgvector/pgvector:pg16
CHATWOOT_REDIS_IMAGEM=redis:7-alpine

N8N_VERSAO=2.35.0
N8N_PG_IMAGEM=postgres:16-alpine
N8N_REDIS_IMAGEM=redis:7-alpine

NOCO_VERSAO=2026.06.1
NOCO_PG_IMAGEM=postgres:16-alpine
